# Klucz OpenRouter dla /api/ocena. Bez niego etap 1 dziala, ale zawsze schodzi
# na werdykt awaryjny z data/komisja.json. Wlasny klucz: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Token zapisu do Vercel Blob dla /api/zgloszenie. Bez niego formularz dziala
# lokalnie w trybie "dev-log" (zapis do konsoli). Tworzy go `vercel blob create-store`.
BLOB_READ_WRITE_TOKEN=
